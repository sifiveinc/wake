package wake

# Generate exactly length random lowercase hex digits; zero returns an empty string.
# This is nondeterministic: using the value in job inputs can prevent cache reuse,
# and embedding it in build outputs makes them non-reproducible.
export def unsafe_randomHexString (length: Integer): Result String Error =
    def raw length: Result String String = prim "unsafe_randomHexString"

    raw length
    | rmapError makeError

# Generate a fresh UUIDv4.
# UUIDs are lowercase strings in the canonical 8-4-4-4-12 hyphenated format.
# This is nondeterministic: using the value in job inputs can prevent cache reuse,
# and embedding it in build outputs makes them non-reproducible.
export def unsafe_uuidv4String (_: a): Result String Error =
    def raw: Result String String = prim "unsafe_uuidv4String"

    raw
    | rmapError makeError
