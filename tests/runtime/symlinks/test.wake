export def datFile Unit =
    write "datFile" "hello world"

export def goodLink Unit =
    require Pass dat =
        datFile Unit
    makeExecPlan ("ln", "-s", "datFile", "goodLink", Nil) (dat, Nil)
    | setPlanLabel "test (symlinks): goodLink"
    | setPlanShare False
    | runJobWith defaultRunner
    | getJobOutput

export def badLink Unit =
    makeExecPlan ("ln", "-s", "badFile", "badLink", Nil) Nil
    | setPlanLabel "test (symlinks): badLink"
    | setPlanShare False
    | runJobWith defaultRunner
    | getJobOutput

export def shouldWork Unit: Result Job Error =
    require Pass link =
        goodLink Unit
    require Pass dat =
        datFile Unit
    makeExecPlan ("cat", "goodLink", Nil) (link, dat, Nil)
    | setPlanLabel "test (symlinks): cat goodLink"
    | editPlanEnvironment (setEnvironment "TEST" "1")
    | setPlanShare False
    | runJobWith defaultRunner
    | Pass

export def shouldFail1 Unit: Result Job Error =
    require Pass link =
        goodLink Unit
    makeExecPlan ("cat", "goodLink", Nil) (link, Nil)
    | setPlanLabel "test (symlinks): cat goodLink shouldFail"
    | editPlanEnvironment (setEnvironment "TEST" "2")
    | setPlanShare False
    | runJobWith defaultRunner
    | Pass

export def shouldFail2 Unit: Result Job Error =
    require Pass dat =
        datFile Unit
    makeExecPlan ("cat", "goodLink", Nil) (dat, Nil)
    | setPlanLabel "test (symlinks): cat goodLink shouldFail2"
    | editPlanEnvironment (setEnvironment "TEST" "3")
    | setPlanShare False
    | runJobWith defaultRunner
    | Pass

export def test _ =
    require Pass link = badLink Unit
    require True = getPathHash link !=* "BadHash"
    else failWithError "dangling symlink does not have a valid hash"
    require Pass validJob = shouldWork Unit
    require True = isJobOk validJob
    else failWithError "reading a valid symlink failed"
    require Pass (_, _, Nil) = validJob.getJobVisible
    else failWithError "did not detect both inputs ({format validJob.getJobVisible})"
    require Pass danglingJob = shouldFail1 Unit
    require False = isJobOk danglingJob
    else failWithError "reading a dangling symlink passed!"
    require Pass unlinkedJob = shouldFail2 Unit
    require False = isJobOk unlinkedJob
    else failWithError "reading a nonexistent symlink passed!"
    Pass 0
