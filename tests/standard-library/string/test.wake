def unicodeStr =
    "[aɪ̯ pʰiː eɪ̯]"

def unicodeBytes =
    91, 97, 201, 170, 204, 175, 32, 112, 202, 176, 105, 203, 144, 32, 101, 201, 170, 204, 175, 93, Nil

export def testToBytes _ =
    unicodeStr
    | unicodeToBytes

export def testToUnicode _ =
    unicodeBytes
    | bytesToUnicode

export def testEquality _ =
    require True = (unicodeStr | unicodeToBytes | bytesToUnicode) ==* unicodeStr

    require 91, 97, 201, 170, 204, 175, 32, 112, 202, 176, 105, 203, 144, 32, 101, 201, 170, 204, 175, 93, Nil =
        unicodeBytes
        | bytesToUnicode
        | unicodeToBytes
    else False

    True

export def testSplitOnce _ =
    require Some (Pair "key" "value0:value1") = splitOnce ":" "key:value0:value1"
    else False

    require Some (Pair "" "value") = splitOnce ":" ":value"
    else False

    require Some (Pair "key" "") = splitOnce ":" "key:"
    else False

    require None = splitOnce ":" "key"
    else False

    require Some (Pair "" "key") = splitOnce "" "key"
    else False

    require Some (Pair "" "") = splitOnce "" ""
    else False

    True
