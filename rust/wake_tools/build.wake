package build_wake

from wake import _
from rust import _

def buildCompanions =
    makeCargoExecutable "wake-tools" "rust/wake_tools"
    |> addCargoFlag "--all-features"
    |> cargoBuildWith (defaultCargoToolchain Unit)

export def buildWakeTools _ =
    require Pass tools = buildCompanions

    require Pass ui = installAs "lib/wake/wake-ui" tools
    require Pass tui = installAs "lib/wake/wake-tui" tools
    require Pass mcp = installAs "lib/wake/wake-mcp" tools
    require Pass otel = installAs "lib/wake/wake-otel" tools

    Pass (ui, tui, mcp, otel, Nil)
