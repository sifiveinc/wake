FROM node:latest

RUN apt-get update && apt-get install -y build-essential devscripts git fuse libfuse-dev libgmp-dev libncurses5-dev libre2-dev uuid-dev libsqlite3-dev pkg-config squashfuse wget jq

RUN useradd -m -d /build build

WORKDIR /build
ENV VERSION=1.80.0
ENV RUST_FOLDER="rust-$VERSION-x86_64-unknown-linux-gnu"
ENV RUST_TAR="$RUST_FOLDER.tar.gz"
RUN wget "https://static.rust-lang.org/dist/$RUST_TAR"
RUN tar -xf $RUST_TAR
RUN sh ./$RUST_FOLDER/install.sh --verbose --prefix=/usr
